# Client-safe (Expo public prefix)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Edge Function secrets (set via `supabase secrets set`, not in the app)
# CRON_SECRET=                    # Required by dispatch-accountability (Deno env)
# EXPO_ACCESS_TOKEN=              # Optional; Expo push API access token
#
# Postgres Vault (vault.secrets names; used by invoke_dispatch_accountability):
#   SUPABASE_URL   — project URL, e.g. https://<ref>.supabase.co
#   CRON_SECRET    — same value as the Edge Function CRON_SECRET

# SMS / Twilio — disabled while ACCOUNTABILITY_CHANNEL is 'push'. Kept for a future revival.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
